# Copy to .env and fill in. .env is gitignored; never commit it.

# dev | test | prod
# dev: collectors cap rows unless --limit is passed (cheap iteration).
# test: pytest only; network calls are replaced by recorded fixtures.
# prod: full pulls; used by the scheduled launchd jobs.
SFRENT_ENV=dev

# RentCast property data API (https://app.rentcast.io -> API dashboard), 500 listings per request.
# RENTCAST_REQUEST_BUDGET is the total number of requests this key may ever spend; the counter
# in data/raw/rentcast/budget.json is cumulative and never resets.
RENTCAST_API_KEY=
RENTCAST_REQUEST_BUDGET=40

# DataSF / Socrata app token (optional; raises rate limits).
# https://data.sf.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# OpenRouteService key (optional; commute stage B from the web app).
ORS_API_KEY=

# Contact string sent in the Craigslist scraper User-Agent so the operator is identifiable.
# Example: "sfrent/0.1 (+https://github.com/you/SF-Housing-Prices; you@example.com)"
CRAIGSLIST_USER_AGENT=

# Override the data directory (defaults to ./data).
# SFRENT_DATA_DIR=
