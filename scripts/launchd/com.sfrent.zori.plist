<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sfrent.zori</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/launchd/run.sh</string>
    <string>zori</string>
  </array>
  <!-- Monthly: Zillow publishes ZORI around the 16th; pull on the 18th. -->
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>18</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REPO__/logs/launchd.zori.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/launchd.zori.log</string>
</dict>
</plist>
